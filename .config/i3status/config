# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
   output_format = "i3bar"
   colors = true
   interval = 5
}

order += "disk /"
order += "wireless wlp4s0"
order += "path_exists VPN"
order += "cpu_temperature 0"
order += "cpu_usage"
order += "load"
order += "memory"
order += "battery all"
order += "volume default"
order += "time"

wireless wlp4s0 {
    format_up = "📶: %essid %signal %ip"
    format_down = "📶: Disconnected"
}

path_exists VPN {
    format = "VPN"
    path = "/proc/sys/net/ipv4/conf/cheap_russian"
}

cpu_temperature 0 {
    format = "CPU: %degrees°C"
    max_threshold = 80
}

cpu_usage {
    format = "%usage"
}

load {
    format = "%1min"
}

memory {
    format = "RAM: %used"
    memory_used_method = "memavailable"
}

disk / {
    format = "%used/%total"
}

battery all {
    format = "%status %percentage %remaining"
    format_percentage = "%.0f%s"
    low_threshold = 60
    threshold_type = "time"
}

time {
    format = "%b %d %a %k:%M %Z"
}

volume default {
    device = "default"
    format = "🎸(%volume)"
    format_muted = "🔇(%volume)"
}

