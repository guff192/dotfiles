desc:4-Band-Joiner 
slider1:0<-42,12,.1>Ch 1/2 Vol (dB)
slider2:0<-42,12,.1>Ch 3/4 Vol (dB)
slider3:0<-42,12,.1>Ch 5/6 Vol (dB)
slider4:0<-42,12,.1>Ch 7/8 Vol (dB)
slider5:0<-100,100,1>Ch 1/2 Pan (%)
slider6:0<-100,100,1>Ch 3/4 Pan (%)
slider7:0<-100,100,1>Ch 5/6 Pan (%)
slider8:0<-100,100,1>Ch 7/8 Pan (%)


@init
c_ampdB = 8.65617025;
b=0;

@slider
band1 = exp(slider1/c_ampdB);
band2 = exp(slider2/c_ampdB);
band3 = exp(slider3/c_ampdB);
band4 = exp(slider4/c_ampdB);
band1 = abs(slider5/100);

@sample
spl0 = spl0 * band1 + spl2 * band2 + spl4 * band3 + spl6 * band4;
spl1 = spl1 * band1 + spl3 * band2 + spl5 * band3 + spl7 * band4;

